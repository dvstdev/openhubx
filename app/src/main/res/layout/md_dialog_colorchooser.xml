<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <GridView
        android:id="@+id/md_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:numColumns="auto_fit"
        android:columnWidth="56dp"
        android:stretchMode="spacingWidthUniform"
        android:horizontalSpacing="8dp"
        android:verticalSpacing="8dp"
        android:gravity="center" />

    <LinearLayout
        android:id="@+id/md_colorChooserCustomFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/md_colorIndicator"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginLeft="12dp"
                android:textStyle="bold"
                android:text="#" />

            <EditText
                android:id="@+id/md_hexInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLines="1"
                android:digits="0123456789abcdefABCDEF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/md_colorALabel"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="A" />

            <SeekBar
                android:id="@+id/md_colorA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255" />

            <TextView
                android:id="@+id/md_colorAValue"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="R" />

            <SeekBar
                android:id="@+id/md_colorR"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255" />

            <TextView
                android:id="@+id/md_colorRValue"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="G" />

            <SeekBar
                android:id="@+id/md_colorG"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255" />

            <TextView
                android:id="@+id/md_colorGValue"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="B" />

            <SeekBar
                android:id="@+id/md_colorB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255" />

            <TextView
                android:id="@+id/md_colorBValue"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
