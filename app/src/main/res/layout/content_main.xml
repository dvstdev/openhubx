<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="com.thirtydegreesray.openhub.ui.activity.MainActivity"
    tools:showIn="@layout/app_bar_main">

    <!-- Content fills the whole area; the floating bar + cards overlay near the bottom. -->
    <FrameLayout
        android:id="@+id/frame_layout_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- ===== Profile selector card (2 x 3) ===== -->
    <android.support.v7.widget.CardView
        android:id="@+id/card_profile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="#E0E0E0"
        app:cardCornerRadius="12dp"
        app:cardElevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bn_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/cell_trace" style="@style/BnCard.Cell"
                    android:text="@string/bn_trace"/>
                <TextView android:id="@+id/cell_notifications" style="@style/BnCard.Cell"
                    android:text="@string/bn_notifications"/>
                <TextView android:id="@+id/cell_bookmarks" style="@style/BnCard.Cell"
                    android:text="@string/bn_bookmarks"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/cell_bookmarks" style="@style/BnCard.Cell"
                    android:text="@string/bn_bookmarks"/>
                <TextView android:id="@+id/cell_my_repos" style="@style/BnCard.Cell"
                    android:text="@string/bn_my_repos"/>
                <TextView android:id="@+id/cell_issues" style="@style/BnCard.Cell"
                    android:text="@string/bn_issues"/>
                <TextView android:id="@+id/cell_starred" style="@style/BnCard.Cell"
                    android:text="@string/bn_starred_repos"/>
            </LinearLayout>
        </LinearLayout>
    </android.support.v7.widget.CardView>

    <!-- ===== Discover selector card (1 x 3) ===== -->
    <android.support.v7.widget.CardView
        android:id="@+id/card_discover"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="#E0E0E0"
        app:cardCornerRadius="12dp"
        app:cardElevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bn_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/cell_random" style="@style/BnCard.Cell"
                    android:text="@string/bn_now"/>
                <TextView android:id="@+id/cell_trending" style="@style/BnCard.Cell"
                    android:text="@string/bn_trending"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/cell_topics" style="@style/BnCard.Cell"
                    android:text="@string/bn_topics"/>
                <TextView android:id="@+id/cell_following" style="@style/BnCard.Cell"
                    android:text="@string/bn_following"/>
            </LinearLayout>
        </LinearLayout>
    </android.support.v7.widget.CardView>

    <!-- ===== More selector card (1 x 2) ===== -->
    <android.support.v7.widget.CardView
        android:id="@+id/card_more"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone"
        app:cardBackgroundColor="#E0E0E0"
        app:cardCornerRadius="12dp"
        app:cardElevation="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bn_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView android:id="@+id/cell_settings" style="@style/BnCard.Cell"
                android:text="@string/bn_settings"/>
            <TextView android:id="@+id/cell_about" style="@style/BnCard.Cell"
                android:text="@string/bn_about"/>
        </LinearLayout>
    </android.support.v7.widget.CardView>

    <!-- ===== Floating centered pill bar (Telegram-style) ===== -->
    <android.support.v7.widget.CardView
        android:id="@+id/bn_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#37474F"
        app:cardCornerRadius="28dp"
        app:cardElevation="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView android:id="@+id/bn_search" style="@style/BnBar.Icon"
                android:src="@drawable/ic_search_title"
                android:tint="#FFFFFF"
                android:contentDescription="@string/bn_search"/>
            <ImageView android:id="@+id/bn_profile" style="@style/BnBar.Icon"
                android:src="@drawable/ic_menu_person"
                android:tint="#FFFFFF"
                android:contentDescription="@string/bn_activities"/>
            <ImageView android:id="@+id/bn_discover" style="@style/BnBar.Icon"
                android:src="@drawable/ic_global"
                android:tint="#FFFFFF"
                android:contentDescription="@string/bn_trending"/>
            <ImageView android:id="@+id/bn_more" style="@style/BnBar.Icon"
                android:src="@drawable/ic_bn_more"
                android:tint="#FFFFFF"
                android:contentDescription="@string/bn_settings"/>
        </LinearLayout>
    </android.support.v7.widget.CardView>

</android.support.constraint.ConstraintLayout>
